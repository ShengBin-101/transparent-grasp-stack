 import os
+import random
 import torch
 import torch.multiprocessing as mp
 import argparse
+import numpy as np
 from run_tools import train, ddp_train, test, inference, realworld_inference, live_inference
 
 
+def set_seed(seed, strict=False):
+    """Pin the RNGs so two runs of one config are repetitions, not samples.
+
+    Nothing upstream seeds anything, so data order and augmentation differ every
+    run and an A-vs-B difference is partly just a different shuffle. Seeding
+    every arm identically makes the comparison paired: B sees the same initial
+    weights, the same sample order and the same augmentation as A, so the delta
+    is the change under test.
+
+    One call covers more than it looks. torch derives each dataloader worker's
+    numpy and `random` seeds from a base_seed that it draws from this process's
+    torch generator (torch/utils/data/_utils/worker.py), so seeding torch here
+    also pins the augmentation drawn inside the 12 workers -- no worker_init_fn
+    needed. The numpy/random seeds below only matter for draws made in this
+    process.
+
+    What a seed does NOT pin is the GPU: cuDNN picks algorithms by autotuning
+    and some backward kernels reduce with non-deterministic atomics. `strict`
+    turns that off too, at a cost in speed, which is why it is not the default.
+    It uses warn_only so an op with no deterministic kernel warns instead of
+    killing a run that is hours in -- meaning strict is "as deterministic as
+    this model allows", and the warnings tell you where it fell short.
+    """
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    torch.cuda.manual_seed_all(seed)
+    if not strict:
+        return
+    # Must be set before the cuBLAS handle is created; importing torch does not
+    # create it, so setting it here is early enough.
+    os.environ.setdefault('CUBLAS_WORKSPACE_CONFIG', ':4096:8')
+    torch.backends.cudnn.deterministic = True
+    torch.backends.cudnn.benchmark = False
+    torch.use_deterministic_algorithms(True, warn_only=True)
+
+
 # def debug():
 #     import debugpy
 #     try:
@@ -50,7 +89,23 @@ if __name__ == '__main__':
     parser.add_argument('--reldepth_model', type=str, default=None,
                         choices=['depthanything', 'leres'],
                         help='rel depth model name')
+    parser.add_argument('--seed', type=int, default=None,
+                        help='RNG seed for weight init, shuffling and augmentation. '
+                             'Omitted = unseeded, which is the upstream behaviour. '
+                             'Use the SAME seed for every arm being compared.')
+    parser.add_argument('--strict-determinism', dest='strict_determinism',
+                        action='store_true',
+                        help='also pin cuDNN algorithm choice and refuse '
+                             'non-deterministic kernels. Slower; only meaningful '
+                             'together with --seed.')
     
     args = parser.parse_args()
+    if args.seed is not None:
+        set_seed(args.seed, args.strict_determinism)
+        print(f'seed: {args.seed}'
+              f'{" (strict determinism)" if args.strict_determinism else ""}')
+    elif args.strict_determinism:
+        print('WARNING: --strict-determinism without --seed pins the kernels but '
+              'not the data order or the augmentation; runs will still differ.')
     # print(args.world_size)
     main(args)
