+"""Self-supervised hole punching: manufacture transparent-style supervision on
+OPAQUE regions, where the raw sensor depth is already correct and free.
+
+After arXiv 2512.05006. The idea is that a transparent object presents the
+network with a region of missing/void input depth that it must fill. Opaque
+objects give you the same *input* condition for free — punch their depth out —
+and unlike a transparent object you already know the answer, because the sensor
+measured it. So every opaque object in every frame becomes a supervised
+completion example at zero annotation cost.
+
+WHY THE EROSION. The source erodes each instance mask with a 5x5 rectangular
+element before punching, on the stated grounds that "the depth of the edge
+contours and the vicinity of the edges can be correctly perceived by the depth
+sensor". Keeping that rim of real measurements gives the network an anchor at
+the object boundary rather than a free-floating void.
+
+THE POLARITY TRAP
+-----------------
+The paper defines
+
+    M_final = J - (M'_non-trans OR M_trans)
+
+which is the **KEEP** mask -- the complement of what gets punched -- and then
+uses it as `D' = M_final (Hadamard) Depth`. Implementing from the prose alone,
+it is natural to read `M_final` as the region being removed and invert the whole
+transform: the network is then handed the transparent region as its ONLY input
+and asked to reconstruct the scene from nothing. This module names the two
+masks `punch` and `keep` so the direction cannot be misread, and
+`tests/test_hole_punching.py` asserts it.
+
+Note the asymmetry between input and target, which is the point of the method:
+
+    input  = depth * keep                      # opaque punched AND transparent removed
+    target = depth * (1 - transparent)         # opaque restored, transparent still gone
+
+The punched opaque pixels are absent from the input and PRESENT in the target.
+The transparent pixels are absent from both, because there the sensor is wrong
+and cannot supervise anything -- that is what the real ground truth is for.
+"""
+import cv2
+import numpy as np
+
+__all__ = ["punch_holes", "ERODE_KERNEL"]
+
+# 5x5 rectangular, as specified.
+ERODE_KERNEL = cv2.getStructuringElement(cv2.MORPH_RECT, (5, 5))
+
+
+def punch_holes(depth, transparent_mask, instance_masks, erode_kernel=None,
+                min_area=200):
+    """Build a self-supervised (input, target, supervised) triple.
+
+    depth            : HxW float, the RAW SENSOR depth. Zero/negative means no
+                       return, and stays that way -- nothing here invents data.
+    transparent_mask : HxW bool. Where the sensor is untrustworthy. Removed from
+                       both input and target.
+    instance_masks   : list of HxW bool, or an HxW integer label image, giving
+                       OPAQUE object instances (e.g. from SAM). Each is eroded
+                       and punched out of the input only.
+    erode_kernel     : structuring element; defaults to 5x5 rectangular.
+    min_area         : instances smaller than this many pixels after erosion are
+                       skipped -- punching a handful of pixels teaches nothing
+                       and mostly removes the edge anchor the erosion preserves.
+
+    Returns (input_depth, target_depth, supervised) where `supervised` marks the
+    pixels this augmentation newly supervises: punched, opaque, and carrying a
+    real sensor return.
+    """
+    depth = np.asarray(depth, dtype=np.float32)
+    transparent = np.asarray(transparent_mask, dtype=bool)
+    if transparent.shape != depth.shape:
+        raise ValueError(f"transparent_mask {transparent.shape} != depth {depth.shape}")
+    kernel = ERODE_KERNEL if erode_kernel is None else erode_kernel
+
+    if isinstance(instance_masks, np.ndarray) and instance_masks.ndim == 2 \
+            and instance_masks.dtype != bool:
+        labels = [instance_masks == v for v in np.unique(instance_masks) if v != 0]
+    else:
+        labels = [np.asarray(m, dtype=bool) for m in (instance_masks or [])]
+
+    punch = np.zeros_like(transparent)
+    for m in labels:
+        if m.shape != depth.shape:
+            raise ValueError(f"instance mask {m.shape} != depth {depth.shape}")
+        m = m & ~transparent                      # never punch a transparent region twice
+        eroded = cv2.erode(m.astype(np.uint8), kernel).astype(bool)
+        if eroded.sum() < min_area:
+            continue
+        punch |= eroded
+
+    keep = ~(punch | transparent)                 # M_final, the KEEP mask
+    input_depth = depth * keep
+    target_depth = depth * ~transparent
+    supervised = punch & (depth > 0)
+    return (input_depth.astype(np.float32),
+            target_depth.astype(np.float32),
+            supervised)
