+    """Per-frame masked RMSE in metres at the network's 640x480, over the
+    transparent mask AND valid GT -- the same region eval/common.py scores,
+    at the training resolution rather than native. Used only for selection."""
+    pred, gt = data_dict["pred"], data_dict["depth_gt"]
+    sel = data_dict["depth_gt_mask"] & data_dict["zero_mask"]
+    out = []
